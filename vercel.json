{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "react-router",
  "regions": ["fra1"],
  "fluid": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.ico|ads.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/instagram-refresh",
      "schedule": "0 4 * * 1"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)ops' ':(exclude)scripts' ':(exclude)*.md'"
}

# WPGraphQL endpoint of the WordPress backend
GRAPHQL_API="https://remix.szinhaz.online/graphql"

# Public origin used in canonical URLs, sitemaps and the feed.
# Leave empty to use the origin of the incoming request.
SITE_URL=""

# Only the production deployment should be indexed by search engines.
# Anything other than "true" serves noindex + a robots.txt that disallows all.
SITE_INDEXABLE="false"
